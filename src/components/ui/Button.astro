---
interface Props { href?: string; variant?: 'primary' | 'secondary' | 'ghost'; type?: 'button' | 'submit'; }
const { href, variant = 'primary', type = 'button' } = Astro.props;
const classes = {
  primary: 'bg-blue-700 text-white hover:bg-blue-800 shadow-sm',
  secondary: 'bg-white text-slate-950 border border-slate-300 hover:border-blue-300 hover:text-blue-800',
  ghost: 'text-slate-700 hover:text-blue-800 hover:bg-blue-50',
}[variant] + ' inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-bold transition focus-ring';
---
{href ? <a href={href} class={classes}><slot /></a> : <button type={type} class={classes}><slot /></button>}
