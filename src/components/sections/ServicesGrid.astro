---
import { services } from '@/data/site';
import SectionHeader from './SectionHeader.astro';
---
<section class="section bg-white">
  <div class="container">
    <SectionHeader eyebrow="Services" title="Digital services built around leads, trust, and repeat business." text="Start with a better website, then expand into management, email marketing, SEO, and ads when the foundation is ready." />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => <a href={service.slug} class="card p-6 transition hover:-translate-y-1 hover:shadow-lg">
        <h3 class="h3">{service.title}</h3><p class="mt-3 text-slate-600">{service.description}</p>
        <span class="mt-5 inline-block text-sm font-bold text-blue-700">Learn more →</span>
      </a>)}
    </div>
  </div>
</section>
