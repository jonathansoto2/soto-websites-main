---
const websites = [
  {
    name: "Palmer's Income Tax",
    domain: "palmersincometax.com",
    url: "https://palmersincometax.com",
    description:
      "Website management and ongoing development for an established tax preparation business.",
    tags: ["Website Management", "Business Website", "Ongoing Development"],
  },
  {
    name: "Yocum Insulation",
    domain: "insulationyocum.com",
    url: "https://insulationyocum.com",
    description:
      "A local-service website designed to clearly present services and help customers request estimates.",
    tags: ["Website Design", "Local Business", "Lead Generation"],
  },
];
---

<section class="section bg-slate-50" id="work">
  <div class="container">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="eyebrow mb-3">Current Work</p>
      <h2 class="h2">Websites I manage.</h2>
      <p class="lead mt-4">
        Real business websites that I currently manage, maintain, and continue to improve.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {websites.map((website) => (
        <article class="card overflow-hidden">
          <div class="border-b border-slate-200 bg-slate-950 p-5">
            <div class="mb-5 flex gap-2">
              <span class="h-3 w-3 rounded-full bg-red-400"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
              <span class="h-3 w-3 rounded-full bg-green-400"></span>
            </div>

            <div class="rounded-xl bg-white p-6">
              <p class="text-sm font-bold uppercase tracking-[0.14em] text-blue-700">
                {website.domain}
              </p>
              <h3 class="mt-3 text-2xl font-black text-slate-950">{website.name}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">
                Live business website
              </p>
            </div>
          </div>

          <div class="p-6">
            <p class="leading-7 text-slate-600">{website.description}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {website.tags.map((tag) => (
                <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-800">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={website.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center font-bold text-blue-700 hover:text-blue-900"
            >
              Visit {website.domain} →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
