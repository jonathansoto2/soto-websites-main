---
import { faqs } from '@/data/site';
import SectionHeader from './SectionHeader.astro';
---
<section class="section bg-slate-50">
  <div class="container max-w-4xl">
    <SectionHeader eyebrow="FAQ" title="Questions business owners usually ask first." center />
    <div class="space-y-4">
      {faqs.map((f) => <details class="card p-6"><summary class="cursor-pointer font-bold text-slate-950">{f.q}</summary><p class="mt-3 leading-7 text-slate-600">{f.a}</p></details>)}
    </div>
  </div>
</section>
