---
import Button from '@/components/ui/Button.astro';
---
<section class="relative overflow-hidden bg-gradient-to-b from-white to-blue-50/60">
  <div class="container grid min-h-[720px] items-center gap-10 py-20 lg:grid-cols-2">
    <div>
      <p class="eyebrow mb-5">Professional Websites for Local Businesses</p>

      <h1 class="h1">
        Need a website for your business?
      </h1>

      <p class="lead mt-6 max-w-2xl">
        I build professional websites that help customers find your business, trust what they see,
        and take the next step — call, request a quote, schedule an appointment, or buy.
      </p>

      <p class="mt-5 max-w-2xl text-slate-600">
        Websites start at <strong class="text-slate-950">$349</strong>. I can also manage your
        website every month so you do not have to worry about updates, hosting, forms, analytics,
        search visibility, or keeping everything working.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="#schedule">Schedule a Free Website Call</Button>
        <Button href="#pricing" variant="secondary">View Pricing</Button>
      </div>

      <p class="mt-5 text-sm font-medium text-slate-500">
        Phone or video consultation. No obligation.
      </p>
    </div>

    <div class="card p-5 lg:p-8">
      <div class="rounded-2xl bg-slate-950 p-4 text-white shadow-2xl">
        <div class="mb-4 flex gap-2">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
          <span class="h-3 w-3 rounded-full bg-green-400"></span>
        </div>

        <div class="rounded-xl bg-white p-6 text-slate-950">
          <p class="text-sm font-bold text-blue-700">SOTO WEBSITES</p>
          <h2 class="mt-3 text-3xl font-black">Websites starting at $349</h2>
          <p class="mt-3 text-slate-600">
            A straightforward website built around what your customers need to see and what you
            want them to do next.
          </p>

          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-blue-50 p-4 font-bold">Mobile Friendly</div>
            <div class="rounded-xl bg-slate-100 p-4 font-bold">Google Setup</div>
            <div class="rounded-xl bg-slate-100 p-4 font-bold">Forms & Scheduling</div>
            <div class="rounded-xl bg-blue-50 p-4 font-bold">Ongoing Management</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
