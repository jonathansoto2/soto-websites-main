---
import Button from '@/components/ui/Button.astro';
import { brand } from '@/data/site';
---
<section class="relative overflow-hidden bg-gradient-to-b from-white to-blue-50/60">
  <div class="container grid min-h-[720px] items-center gap-10 py-20 lg:grid-cols-2">
    <div>
      <p class="eyebrow mb-5">{brand.tagline}</p>
      <h1 class="h1">A modern website that helps local customers trust you and contact you.</h1>
      <p class="lead mt-6 max-w-2xl">Soto Websites builds fast, professional websites and digital systems for service businesses that need more leads, better credibility, and less time wasted on tech.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row"><Button href="/contact">Get a Free Website Review</Button><Button href="/services" variant="secondary">View Services</Button></div>
      <p class="mt-5 text-sm font-medium text-slate-500">Built for contractors, restaurants, dental offices, gyms, coaches, attorneys, auto shops, and local service brands.</p>
    </div>
    <div class="card p-5 lg:p-8">
      <div class="rounded-2xl bg-slate-950 p-4 text-white shadow-2xl">
        <div class="mb-4 flex gap-2"><span class="h-3 w-3 rounded-full bg-red-400"></span><span class="h-3 w-3 rounded-full bg-yellow-400"></span><span class="h-3 w-3 rounded-full bg-green-400"></span></div>
        <div class="rounded-xl bg-white p-6 text-slate-950">
          <p class="text-sm font-bold text-blue-700">LOCAL BUSINESS WEBSITE</p>
          <h2 class="mt-3 text-3xl font-black">Book more jobs this month.</h2>
          <p class="mt-3 text-slate-600">Clear services. Fast load time. Strong calls to action. Built for phones first.</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2"><div class="rounded-xl bg-blue-50 p-4 font-bold">Call Button</div><div class="rounded-xl bg-slate-100 p-4 font-bold">Quote Form</div><div class="rounded-xl bg-slate-100 p-4 font-bold">Reviews</div><div class="rounded-xl bg-blue-50 p-4 font-bold">Service Areas</div></div>
        </div>
      </div>
    </div>
  </div>
</section>
