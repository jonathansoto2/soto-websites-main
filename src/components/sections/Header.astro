---
import { brand, nav } from '@/data/site';
import Button from '@/components/ui/Button.astro';
---
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="container flex h-20 items-center justify-between">
    <a href="/" class="flex items-center gap-3 font-black text-slate-950 focus-ring rounded-lg" aria-label={`${brand.name} home`}>
      <span class="grid h-10 w-10 place-items-center rounded-2xl bg-blue-700 text-white">SW</span>
      <span>{brand.name}</span>
    </a>
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      {nav.map((item) => <a class="text-sm font-semibold text-slate-600 hover:text-blue-800" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="hidden sm:block"><Button href="/contact">Free Website Review</Button></div>
    <details class="lg:hidden">
      <summary class="cursor-pointer rounded-lg p-2 font-semibold">Menu</summary>
      <nav class="absolute left-4 right-4 top-20 rounded-2xl border border-slate-200 bg-white p-4 shadow-xl">
        {nav.map((item) => <a class="block rounded-xl px-4 py-3 font-semibold text-slate-700 hover:bg-blue-50" href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
