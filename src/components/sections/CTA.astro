---
import Button from '@/components/ui/Button.astro';
---
<section class="section bg-blue-800 text-white">
  <div class="container text-center">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-100">Free consultation</p>
    <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-black tracking-tight sm:text-5xl">Ready to turn your website into a real business asset?</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-blue-100">Send a message and get a straightforward review of what your website needs next.</p>
    <div class="mt-8"><Button href="/contact" variant="secondary">Request a Free Website Review</Button></div>
  </div>
</section>
