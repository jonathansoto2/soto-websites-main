---
import Button from '@/components/ui/Button.astro';
---
<section class="section bg-blue-800 text-white">
  <div class="container text-center">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-100">
      Free Website Consultation
    </p>

    <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-black tracking-tight sm:text-5xl">
      Not sure which website option your business needs?
    </h2>

    <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-blue-100">
      Schedule a free call and tell me what your business does, what you need the website to do,
      and what you are trying to improve.
    </p>

    <div class="mt-8">
      <Button href="#schedule" variant="secondary">Schedule a Free Call</Button>
    </div>
  </div>
</section>
