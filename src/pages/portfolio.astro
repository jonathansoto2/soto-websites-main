---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/sections/CTA.astro';
---

<BaseLayout
  title="Website Portfolio | Soto Websites"
  description="View website design and redesign projects completed by Soto Websites for local businesses."
>
  <section class="section bg-white">
    <div class="container max-w-5xl">
      <p class="eyebrow mb-3">Portfolio</p>
      <h1 class="h1">Websites built to support real businesses</h1>
      <p class="lead mt-6">
        Explore selected website design, redesign, and management projects.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <article class="card p-6">
          <p class="text-sm font-semibold text-blue-700">Tax Preparation</p>
          <h2 class="h3 mt-2">Palmers Income Tax</h2>
          <p class="mt-3 text-slate-600">
            A modern business website designed to improve trust, simplify client communication, and support future online services.
          </p>
        </article>

        <article class="card p-6">
          <p class="text-sm font-semibold text-blue-700">Future Project</p>
          <h2 class="h3 mt-2">Your Business Could Be Here</h2>
          <p class="mt-3 text-slate-600">
            Additional client work and case studies will be added as projects are completed.
          </p>
        </article>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>